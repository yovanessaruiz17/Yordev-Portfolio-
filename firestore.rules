rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidProject(data) {
      return ('id' in data)
        && ('titulo' in data && data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 500)
        && (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() <= 20000));
    }

    function isValidBlogPost(data) {
      return ('id' in data)
        && ('titulo' in data && data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 500)
        && (!('extracto' in data) || (data.extracto is string && data.extracto.size() <= 20000));
    }

    function isValidCompanyConfig(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 300))
        && (!('nombre' in data) || (data.nombre is string && data.nombre.size() <= 300));
    }

    function isValidTestimonial(data) {
      return ('id' in data)
        && ('nombre' in data && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 300)
        && ('comentario' in data && data.comentario is string && data.comentario.size() <= 10000);
    }

    // Colección de verificación de conectividad
    match /test/{testId} {
      allow read, write: if true;
    }

    // Colección de Proyectos del Portafolio
    match /proyectos/{projectId} {
      allow read: if true;
      allow create, update: if isValidId(projectId) && isValidProject(incoming());
      allow delete: if isValidId(projectId);
    }

    // Colección de Artículos del Blog Técnico
    match /articulos_blog/{postId} {
      allow read: if true;
      allow create, update: if isValidId(postId) && isValidBlogPost(incoming());
      allow delete: if isValidId(postId);
    }

    // Colección de Reseñas y Testimonios de Google
    match /testimonios/{testimonialId} {
      allow read: if true;
      allow create, update: if isValidId(testimonialId) && isValidTestimonial(incoming());
      allow delete: if isValidId(testimonialId);
    }

    // Colección de Configuración de Empresa y Redes de Contacto
    match /configuracion/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && isValidCompanyConfig(incoming());
      allow delete: if isValidId(configId);
    }
  }
}
